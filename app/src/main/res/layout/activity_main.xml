<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/sable">

    <!-- Bandeau : titre, version, bouton de mise à jour -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/lagon"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reo Huri"
                android:textColor="@color/blanc"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vidéo anglaise → texte anglais exact"
                android:textColor="#D5EEF0"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMaj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/blanc"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnUpdate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mettre à jour l'application"
                android:src="@drawable/ic_update" />

            <View
                android:id="@+id/dotUpdate"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Barre de mise à jour -->
    <ProgressBar
        android:id="@+id/barMaj"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progressDrawable="@drawable/bar_maj"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtUrl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/card"
                android:hint="Lien YouTube"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/encre"
                android:textColorHint="@color/gris"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPaste"
                style="@style/BoutonContour"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Coller" />

            <Button
                android:id="@+id/btnPick"
                style="@style/BoutonContour"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Fichier…" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="Collez un lien YouTube ou choisissez un fichier vidéo ou audio."
            android:textColor="@color/gris"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/lagon"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/chkHoro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/lagon"
                android:checked="true"
                android:text="Horodatages"
                android:textColor="@color/encre"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/btn_action"
            android:text="Obtenir le texte anglais"
            android:textAllCaps="false"
            android:textColor="@color/blanc"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/bar_travail"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/encre"
            android:textSize="13sp" />

        <!-- Texte anglais, à relire et corriger -->
        <EditText
            android:id="@+id/edtTexte"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/card"
            android:gravity="top|start"
            android:hint="Le texte anglais apparaîtra ici. Vous pourrez le corriger avant de l'enregistrer."
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/encre"
            android:textColorHint="@color/gris"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:background="@drawable/btn_lagon"
                android:text="Enregistrer"
                android:textAllCaps="false"
                android:textColor="@color/blanc"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnShare"
                style="@style/BoutonContour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Partager" />

            <Button
                android:id="@+id/btnCopy"
                style="@style/BoutonContour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Copier" />

            <Button
                android:id="@+id/btnFix"
                style="@style/BoutonContour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.3"
                android:text="Corrections" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
